# Server Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to version control.

# ─── Application Mode ───────────────────────────────────────────────────────────
# Set to 'production' on deployment (Render, Railway, Heroku, AWS, DigitalOcean)
NODE_ENV=production
PORT=5000

# ─── MongoDB Atlas Database ─────────────────────────────────────────────────────
# Obtain from MongoDB Atlas:
# Database Deployment -> Connect -> Drivers (Node.js) -> Add connection string.
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/<database_name>?retryWrites=true&w=majority
# IMPORTANT: If your password contains special characters (@, :, /, #, %, etc.),
# they MUST be URL-encoded (e.g. '@' -> '%40', ':' -> '%3A').
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/swan_lms?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate a cryptographically secure 64-byte random key:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string_min_64_chars
JWT_EXPIRES_IN=7d

# ─── Cookie Security ────────────────────────────────────────────────────────────
# Must be "true" in production (requires HTTPS)
COOKIE_SECURE=true
# Use "none" if frontend & backend are on different domains (e.g., frontend on vercel.app, backend on onrender.com)
# Use "lax" if frontend & backend are served from the same domain or behind a reverse proxy.
COOKIE_SAME_SITE=none
COOKIE_MAX_AGE_MS=604800000

# ─── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: https://swan-lms.vercel.app,https://yourdomain.com
CLIENT_ORIGIN=https://your-frontend-deployment.vercel.app

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ─── Administrator Registration Secret Key ────────────────────────────────
ADMIN_SECRET_KEY=swan_admin_secret_key_2026
